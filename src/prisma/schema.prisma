generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DB_URL")
}

model User {
  id                        String         @id @default(auto()) @map("_id") @db.ObjectId
  email                     String         @unique
  password                  String
  firstName                 String?
  lastName                  String?
  middleName                String?
  dateOfBirth               String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  secretCode                Int            @unique
  referral                  Int
  country                   String
  phoneNumber               String?
  username                  String?
  isVerify                  Int?
  balance                   Int?
  rzmBalance                Int?
  totalContracts            Int?
  locale                    String?
  avatar                    String?
  level                     String?
  link                      String?
  hasPromo                  Boolean?
  isTelegramConnect         Boolean?
  canRequestCard            Boolean?
  hasHeir                   Boolean?
  showGlobalStat            Boolean?
  inviter                   Inviter?
  socialMedia               SocialMedia?
  notifications             Notifications?
}

model Inviter {
  id                        String         @id @default(auto()) @map("_id") @db.ObjectId
  name                      String?
  email                     String?
  phone                     String?
  avatar                    String?
  userId                    String         @unique
  user                      User           @relation(fields: [userId], references: [id])
}

model SocialMedia {
  id                        String         @id @default(auto()) @map("_id") @db.ObjectId
  facebook                  String?
  instagram                 String?
  twitter                   String?
  telegram                  String?
  userId                    String         @unique
  user                      User           @relation(fields: [userId], references: [id])
}

model Notifications {
  id                        String         @id @default(auto()) @map("_id") @db.ObjectId
  onIncomeMail              Boolean?
  onContractIncomeMail      Boolean?
  onSuccessWithdrawMail     Boolean?
  onStartBonusMail          Boolean?
  onNewItemsInCalendarMail  Boolean?
  onEventMail               Boolean?
  onCourseMail              Boolean?
  onWebinarsMail            Boolean?
  onNewsMail                Boolean?
  onIncomeTg                Boolean?
  onContractIncomeTg        Boolean?
  onSuccessWithdrawTg       Boolean?
  onStartBonusTg            Boolean?
  onNewItemsInCalendarTg    Boolean?
  onEventTg                 Boolean?
  onCourseTg                Boolean?
  onWebinarsTg              Boolean?
  onNewsTg                  Boolean?
  userId                    String         @unique
  user                      User           @relation(fields: [userId], references: [id])
}
